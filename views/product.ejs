<section class="page-product" aria-labelledby="product-title">
  <% if (Array.isArray(breadcrumbs) && breadcrumbs.length) { %>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol class="breadcrumbs__list">
        <% breadcrumbs.forEach((crumb, index) => { %>
          <li class="breadcrumbs__item">
            <% if (crumb.href && index < breadcrumbs.length - 1) { %>
              <a class="breadcrumbs__link" href="<%= crumb.href %>"><%= crumb.label %></a>
            <% } else { %>
              <span class="breadcrumbs__current" aria-current="page"><%= crumb.label %></span>
            <% } %>
            <% if (index < breadcrumbs.length - 1) { %>
              <span class="breadcrumbs__separator" aria-hidden="true">/</span>
            <% } %>
          </li>
        <% }) %>
      </ol>
    </nav>
  <% } %>

  <section class="product-hero">
    <div class="product-hero__media">
      <%- include('partials/product-media', {
        product,
        mediaClass: 'product-media--detail',
        mediaLoading: 'eager'
      }) %>
    </div>

    <div class="product-hero__info">
      <div class="product-hero__header">
        <p class="product-hero__brand"><%= product.brand %></p>
        <h1 id="product-title"><%= product.name %></h1>
      </div>

      <p class="product-hero__lede"><%= product.description %></p>

      <div class="product-hero__rating">
        <%- include('partials/rating', { product, ratingClass: 'rating--lg' }) %>
        <span class="product-hero__sold">
          <%= Number(product.amount_sold || 0).toLocaleString('en-PH') %> sold
        </span>
      </div>

      <div class="product-hero__pricing">
        <div class="product-hero__price-row">
          <span class="product-hero__price"><%= formatPrice(product.discounted_price) %></span>
          <% if (product.real_price > product.discounted_price) { %>
            <span class="product-hero__price-old"><%= formatPrice(product.real_price) %></span>
          <% } %>
          <% if (savingsPercentValue > 0) { %>
            <span class="product-hero__save">Save <%= savingsPercentValue %>%</span>
          <% } %>
        </div>
      </div>

      <%
        const isSaved = typeof wishlistIds !== 'undefined' && wishlistIds.includes(Number(product.id));
      %>
      <form class="product-hero__buy" method="POST" action="/cart/add">
        <input type="hidden" name="productId" value="<%= product.id %>" />
        <input type="hidden" name="next" value="/product/<%= product.slug %>" />
        <div class="qty" data-qty>
          <button class="qty__button" type="button" data-qty-decrease aria-label="Decrease quantity">
            <i data-lucide="minus" aria-hidden="true"></i>
          </button>
          <input
            class="qty__input"
            type="text"
            inputmode="numeric"
            name="quantity"
            value="1"
            min="1"
            max="10"
            aria-label="Quantity"
            data-qty-input
          />
          <button class="qty__button" type="button" data-qty-increase aria-label="Increase quantity">
            <i data-lucide="plus" aria-hidden="true"></i>
          </button>
        </div>
        <button class="btn btn--primary product-hero__add" type="submit">
          <i data-lucide="shopping-bag" aria-hidden="true"></i>
          Add to cart
        </button>
        <button class="btn btn--ghost product-hero__buy-now" type="submit" name="checkout" value="1">
          <i data-lucide="zap" aria-hidden="true"></i>
          Buy now
        </button>
        <button
          class="btn btn--ghost product-hero__wishlist<%= isSaved ? ' is-saved' : '' %>"
          type="submit"
          formaction="/wishlist/toggle"
          formmethod="post"
          aria-pressed="<%= isSaved ? 'true' : 'false' %>"
          aria-label="<%= isSaved ? 'Remove from saved gear' : 'Save to saved gear' %>"
          title="<%= isSaved ? 'Remove from saved gear' : 'Save to saved gear' %>"
        >
          <i data-lucide="heart" aria-hidden="true"></i>
        </button>
      </form>

      <ul class="product-hero__assurances">
        <li class="assurance">
          <i data-lucide="truck" aria-hidden="true"></i>
          <span>
            <strong>Free shipping</strong>
            <small>Orders <%= formatPrice(2000) %> and up</small>
          </span>
        </li>
        <li class="assurance">
          <i data-lucide="shield-check" aria-hidden="true"></i>
          <span>
            <strong>1-year warranty</strong>
            <small>Official distributor</small>
          </span>
        </li>
        <li class="assurance">
          <i data-lucide="rotate-ccw" aria-hidden="true"></i>
          <span>
            <strong>7-day returns</strong>
            <small>Hassle-free</small>
          </span>
        </li>
      </ul>

      <section class="spec-strip" aria-label="Key specifications">
        <% specContent.highlights.forEach((highlight) => { %>
          <div class="spec-strip__item">
            <i data-lucide="<%= highlight.icon %>" aria-hidden="true"></i>
            <span class="spec-strip__value"><%= highlight.value %></span>
            <span class="spec-strip__label"><%= highlight.label %></span>
          </div>
        <% }) %>
      </section>
    </div>
  </section>

  <%
    const tabId = `product-tabs-${product.slug}`;
    const tabs = [
      { id: 'overview', label: 'Overview' },
      { id: 'specifications', label: 'Specifications' },
      { id: 'box', label: "What's in the box" },
    ];
  %>
  <section class="product-tabs" data-tabs aria-label="Product details">
    <div class="product-tabs__list" role="tablist" aria-label="Product details">
      <% tabs.forEach((tab, index) => { %>
        <button
          class="product-tabs__tab<%= index === 0 ? ' is-active' : '' %>"
          id="<%= tabId %>-tab-<%= tab.id %>"
          type="button"
          role="tab"
          aria-selected="<%= index === 0 ? 'true' : 'false' %>"
          aria-controls="<%= tabId %>-panel-<%= tab.id %>"
          tabindex="<%= index === 0 ? '0' : '-1' %>"
        ><%= tab.label %></button>
      <% }) %>
    </div>

    <div class="product-tabs__panels">
      <div
        class="product-tabs__panel"
        id="<%= tabId %>-panel-overview"
        role="tabpanel"
        aria-labelledby="<%= tabId %>-tab-overview"
        tabindex="0"
      >
        <div class="overview">
          <% specContent.overview.forEach((paragraph) => { %>
            <p><%= paragraph %></p>
          <% }) %>
        </div>
      </div>

      <div
        class="product-tabs__panel"
        id="<%= tabId %>-panel-specifications"
        role="tabpanel"
        aria-labelledby="<%= tabId %>-tab-specifications"
        tabindex="0"
        hidden
      >
        <div class="spec-groups">
          <% specContent.specs.forEach((group) => { %>
            <section class="spec-group">
              <h2 class="spec-group__title"><%= group.title %></h2>
              <dl class="spec-group__list">
                <% group.items.forEach((item) => { %>
                  <div class="spec-row">
                    <dt><%= item.label %></dt>
                    <dd><%= item.value %></dd>
                  </div>
                <% }) %>
              </dl>
            </section>
          <% }) %>
        </div>
      </div>

      <div
        class="product-tabs__panel"
        id="<%= tabId %>-panel-box"
        role="tabpanel"
        aria-labelledby="<%= tabId %>-tab-box"
        tabindex="0"
        hidden
      >
        <ul class="box-list">
          <% specContent.box.forEach((item) => { %>
            <li class="box-item">
              <i data-lucide="check" aria-hidden="true"></i>
              <span><%= item %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </section>

  <noscript>
    <style>
      .product-tabs__panel[hidden] {
        display: block;
      }
      .product-tabs__list {
        display: none;
      }
    </style>
  </noscript>

  <% if (related && related.length) { %>
    <section class="related">
      <header class="related__header">
        <div>
          <p class="eyebrow">You might also like</p>
          <h2>Related products</h2>
        </div>
      </header>
      <div class="product-grid">
        <% related.forEach((item) => { %>
          <%- include('partials/product-card', { product: item }) %>
        <% }) %>
      </div>
    </section>
  <% } %>
</section>
