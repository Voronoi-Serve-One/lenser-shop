<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#121212" />
    <link rel="stylesheet" href="/css/style.css" />
    <title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Lenser' %></title>
    <meta
      name="description"
      content="<%= typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : 'Cameras, lenses, and accessories for the way you shoot.' %>"
    />
    <script src="https://unpkg.com/lucide@1.63.0/dist/umd/lucide.min.js" defer></script>
  </head>
  <body>
    <%- include("partials/header") %>
    <main>
      <div class="main-body"><%- body %></div>
    </main>

    <%- include("partials/footer") %>
    <div class="toast-region" data-toast-region aria-live="polite" aria-atomic="false"></div>
    <!-- Functionality Script -->
    <script src="/js/main.js" defer></script>
  </body>
</html>
