              </a>
            <% }) %>
          </div>
        </div>
      </div>
      <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>" <%- currentPath === '/about' ? 'aria-current="page"' : '' %>>About us</a>
    </nav>

    <div class="misc">
      <div class="nav-item--search">
        <button
          class="icon-btn"
          type="button"
          aria-label="Search"
          aria-expanded="false"
          aria-controls="search-menu"
          data-search-trigger
        >
          <i data-lucide="search"></i>
        </button>

        <div class="dropdown dropdown--search" id="search-menu" data-search-menu>
          <form class="search-form" action="/search" method="GET" role="search">
            <label class="sr-only" for="header-search">Search products</label>
            <i data-lucide="search" class="search-form__icon" aria-hidden="true"></i>
            <input
              id="header-search"
              name="q"
              type="search"
              placeholder="Search cameras, lenses, gear"
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
              autocomplete="off"
              maxlength="100"
              data-search-input
            />
            <button class="search-form__submit" type="submit" aria-label="Search products">
              <i data-lucide="arrow-right" aria-hidden="true"></i>
            </button>
          </form>

          <div class="nav-search__quick">
            <span>Popular</span>
            <% searchQuickLinks.slice(0, 4).forEach((item) => { %>
              <a href="<%= item.href %>"><%= item.label %></a>
            <% }) %>
          </div>
        </div>
      </div>
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="nav-item nav-item--account<%= currentPath === '/account' ? ' is-current' : '' %>">
          <button
            class="account-trigger"
            type="button"
            aria-expanded="false"
            aria-controls="account-menu"
            aria-label="Account menu for <%= user.first_name %> <%= user.last_name %>"
            data-account-trigger
          >
            <span class="account-trigger__avatar" aria-hidden="true"><%= userInitials || '?' %></span>
            <i data-lucide="chevron-down" class="account-trigger__chevron" aria-hidden="true"></i>
          </button>
          <div class="dropdown dropdown--account" id="account-menu" data-account-menu>
            <a class="account-menu__link" href="/account">
              <i data-lucide="layout-dashboard" class="account-menu__icon" aria-hidden="true"></i>
              <span>Account overview</span>
            </a>
            <a class="account-menu__link" href="/account#orders">
              <i data-lucide="package" class="account-menu__icon" aria-hidden="true"></i>
              <span>Orders</span>
            </a>
            <a class="account-menu__link" href="/account#saved">
              <i data-lucide="heart" class="account-menu__icon" aria-hidden="true"></i>
              <span>Saved gear</span>
            </a>
            <span class="account-menu__rule" aria-hidden="true"></span>
            <a class="account-menu__link account-menu__link--quiet" href="/logout">
              <i data-lucide="log-out" class="account-menu__icon" aria-hidden="true"></i>
              <span>Sign out</span>
            </a>
          </div>
        </div>
      <% } else { %>
        <a class="icon-btn" href="/register" aria-label="Create account">
          <i data-lucide="user-round"></i>
        </a>
      <% } %>
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="nav-item--cart">
          <button
            class="icon-btn icon-btn--cart"
            type="button"
            aria-expanded="false"
            aria-controls="cart-menu"
            aria-label="Cart<%= cartCount > 0 ? `, ${cartCount} item${cartCount === 1 ? '' : 's'}` : ', empty' %>"
            data-cart-trigger
          >
            <i data-lucide="shopping-cart"></i>
            <% if (cartCount > 0) { %>
              <span class="cart-count" aria-hidden="true"><%= cartCount > 9 ? '9+' : cartCount %></span>
            <% } %>
          </button>

          <div class="dropdown dropdown--cart" id="cart-menu" data-cart-menu aria-label="Cart preview">
            <%- include('mini-cart', { cartPreview, cartCount, cartLines, cartSubtotal }) %>
          </div>
        </div>
      <% } else { %>
        <a class="icon-btn icon-btn--cart" href="/cart" aria-label="Cart">
          <i data-lucide="shopping-cart"></i>
        </a>
      <% } %>
    </div>
  </div>

  <div class="brands" role="group" aria-label="Brands we carry">
    <svg class="brand-logo brand-logo--sony" role="img" aria-label="Sony" viewBox="0 0 99 18" fill="currentColor">
      <use href="#sony-logo" xlink:href="#sony-logo" />
    </svg>
    <span class="brand-divider" aria-hidden="true"></span>
    <svg class="brand-logo brand-logo--canon" role="img" aria-label="Canon" viewBox="0 0 88 18" fill="currentColor">
      <use href="#canon-logo" xlink:href="#canon-logo" />
    </svg>
    <span class="brand-divider" aria-hidden="true"></span>
    <svg class="brand-logo brand-logo--nikon" role="img" aria-label="Nikon" viewBox="0 0 61 17" fill="currentColor">
      <use href="#nikon-logo" xlink:href="#nikon-logo" />
    </svg>
    <span class="brand-divider" aria-hidden="true"></span>
    <svg class="brand-logo brand-logo--gopro" role="img" aria-label="GoPro" viewBox="0 0 128 18" fill="currentColor">
      <use href="#gopro-logo" xlink:href="#gopro-logo" />
    </svg>
  </div>

  <nav class="nav-bottom" aria-label="Shop sections">
    <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>" <%- currentPath === '/' ? 'aria-current="page"' : '' %>>Home</a>
    <a href="/featured" class="<%= currentPath === '/featured' ? 'active' : '' %>" <%- currentPath === '/featured' ? 'aria-current="page"' : '' %>>Featured</a>
    <a href="/deals" class="<%= currentPath === '/deals' ? 'active' : '' %>" <%- currentPath === '/deals' ? 'aria-current="page"' : '' %>>Deals</a>
    <a href="/best-sellers" class="<%= currentPath === '/best-sellers' ? 'active' : '' %>" <%- currentPath === '/best-sellers' ? 'aria-current="page"' : '' %>>Best Sellers</a>
    <a href="/new-arrivals" class="<%= currentPath === '/new-arrivals' ? 'active' : '' %>" <%- currentPath === '/new-arrivals' ? 'aria-current="page"' : '' %>>New Arrivals</a>
    <span class="nav-bottom__indicator" aria-hidden="true"></span>
  </nav>

  <div class="search-scrim" aria-hidden="true"></div>
</header>
