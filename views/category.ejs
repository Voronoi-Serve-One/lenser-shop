<section class="category-page">
  <header class="category-page__header">
    <div>
      <p class="eyebrow">Shop</p>
      <h1><%= title %></h1>
      <p class="category-page__count"><%= items.length %> item<%= items.length === 1 ? '' : 's' %></p>
    </div>
  </header>
  <div class="product-grid">
    <% items.forEach((product) => { %>
      <article class="product-card">
        <a class="product-card__media-link" href="/product/<%= product.slug %>">
          <%- include('partials/product-media', { product }) %>
        </a>
        <div class="product-card__body">
          <div class="product-card__meta">
            <span class="product-card__brand"><%= product.brand %></span>
            <% if (discountPercent(product) > 0) { %>
              <span class="product-card__badge">-<%= discountPercent(product) %>%</span>
            <% } %>
          </div>
          <h3 class="product-card__title">
            <a href="/product/<%= product.slug %>"><%= product.name %></a>
          </h3>
          <div class="product-card__pricing">
            <span class="product-card__price"><%= formatPrice(product.discounted_price) %></span>
            <% if (product.real_price > product.discounted_price) { %>
              <span class="product-card__price product-card__price--old"><%= formatPrice(product.real_price) %></span>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</section>
