<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__copy">
    <h1 id="hero-heading">See it before you shoot it.</h1>
    <p class="hero__lede">
      Cameras, lenses, and accessories picked for the way you actually shoot.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/featured">Shop featured</a>
      <a class="btn btn--ghost" href="/new-arrivals">See new arrivals</a>
    </div>
  </div>

  <figure class="hero__media">
    <img
      src="/assets/blog/vintage-nikkon.webp"
      width="1536"
      height="1024"
      alt="Vintage Nikon camera from the Lenser collection"
      loading="eager"
      fetchpriority="high"
    />
    <span class="hero__corner hero__corner--tl" aria-hidden="true"></span>
    <span class="hero__corner hero__corner--tr" aria-hidden="true"></span>
    <span class="hero__corner hero__corner--bl" aria-hidden="true"></span>
    <span class="hero__corner hero__corner--br" aria-hidden="true"></span>
    <div class="hero__hud" aria-hidden="true">
      <div class="hero__hud-group hero__hud-group--mode">
        <span class="hero__hud-mode">A</span>
        <span class="hero__hud-label">ISO 100</span>
      </div>
      <div class="hero__hud-group hero__hud-group--exposure">
        <span class="hero__hud-value">1/1000</span>
        <span class="hero__hud-subvalue">f/1.4</span>
      </div>
      <div class="hero__hud-group hero__hud-group--meter">
        <span class="hero__hud-meter">
          <span class="hero__hud-meter-line"></span>
          <span class="hero__hud-meter-labels">
            <span>-</span><span>0</span><span>+</span>
          </span>
        </span>
      </div>
    </div>
    <figcaption class="hero__caption">
      <span class="hero__caption-title">Nikkormat EL, 1972</span>
      <span class="hero__caption-fact">Nikon's first aperture-priority AE</span>
      <span class="hero__caption-fact">Nikkor-S.C Auto 50mm f/1.4</span>
    </figcaption>
  </figure>
</section>

<section class="section" aria-labelledby="featured-heading">
  <%- include('partials/section-heading', {
    id: 'featured-heading',
    title: 'Featured this week',
    href: '/featured',
    linkLabel: 'View all featured'
  }) %>

  <div class="product-grid">
    <% featuredProducts.forEach(function (product) { %>
      <%- include('partials/product-card', { product: product }) %>
    <% }); %>
  </div>
</section>

<section class="section" aria-labelledby="new-heading">
  <%- include('partials/section-heading', {
    id: 'new-heading',
    title: 'New arrivals',
    href: '/new-arrivals',
    linkLabel: 'View all new arrivals'
  }) %>

  <div class="product-grid">
    <% newProducts.forEach(function (product) { %>
      <%- include('partials/product-card', { product: product }) %>
    <% }); %>
  </div>
</section>
